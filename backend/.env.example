PORT=3000
DATABASE_URL=postgres://temveg:temveg@localhost:5432/temveg
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-with-32-plus-chars
# development or production (production marks the session cookie as secure)
NODE_ENV=development
# Origin of the frontend allowed to call the API with cookies (Vite dev server)
CORS_ORIGIN=http://localhost:5173
# How many proxies in front of the API add to X-Forwarded-For (0: none, uses
# the connection address for the login attempt limit)
TRUST_PROXY=0
